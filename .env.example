# --- Client (exposed in the browser bundle) ---
VITE_SUPABASE_ANON_KEY=API_KEY_HERE
VITE_SUPABASE_URL=API_KEY_HERE

# --- Server only (used by /api functions, never exposed to the browser) ---
SUPABASE_URL=API_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=API_KEY_HERE
GROQ_API_KEY=API_KEY_HERE
GROQ_ALLOWED_MODELS=openai/gpt-oss-120b
GROQ_GRADING_MODEL=openai/gpt-oss-120b
# Optional: override the Groq multimodal model used as a vision fallback.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Google AI Studio key for the /api/vision image transcription endpoint.
# When unset, image transcription falls back to local Tesseract OCR.
GEMINI_API_KEY=API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash

# Optional: durable rate limiting. When unset, the API falls back to an
# in-memory limiter (per instance, not shared across deployments).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
